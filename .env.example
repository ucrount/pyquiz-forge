# ==== App ====
APP_NAME=pyquiz-forge
APP_ENV=production
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ==== Database ====
# SQLite file path (relative to working dir, will be /app/data inside container)
DATABASE_URL=sqlite:///./data/pyquiz.db

# ==== CORS ====
# Comma-separated origins. Use * for any (NOT recommended in production).
CORS_ORIGINS=*

# ==== Default LLM Config (seeded on first startup if no config exists) ====
# Provider: openai | deepseek | qwen | moonshot | claude
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_API_KEY=sk-your-api-key-here
DEFAULT_LLM_API_BASE=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_LLM_TEMPERATURE=0.7
DEFAULT_LLM_MAX_TOKENS=2048

# ==== Code Sandbox (Piston) ====
# 在线练习的编程题判分会把代码送到 Piston 沙盒执行。
# 默认走 emkc.org 公共 API（零运维，但国内服务器可能超时）。
# 如果不可达，请改成本地自部署：docker run -d -p 2000:2000 ghcr.io/engineer-man/piston
# 然后把下面改成 PISTON_API_BASE=http://piston:2000/api/v2
PISTON_API_BASE=https://emkc.org/api/v2/piston
PISTON_RUN_TIMEOUT_MS=5000
PISTON_COMPILE_TIMEOUT_MS=10000

# ==== Build-time mirrors (Optional) ====
# Uncomment & set these BEFORE running `docker compose build` if you're on a
# slow / Great-Firewalled network. They speed up the first build by ~10x.
# Defaults are the official upstream mirrors.
#
# Notes for APT_MIRROR: provide ONLY the host (no trailing /debian),
# the Dockerfile substitutes http://deb.debian.org with https://<APT_MIRROR>
# which gives correct paths like /debian and /debian-security.
#
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
