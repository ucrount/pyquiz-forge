        {"code": "js-4.2", "title": "闭包", "order_index": 2, "keywords": ["closure", "作用域链", "私有变量"], "description": "闭包概念与应用"},
        {"code": "js-4.3", "title": "this 与 bind/call/apply", "order_index": 3, "keywords": ["this", "bind", "call", "apply"], "description": "this 指向规则"},
        {"code": "js-4.4", "title": "高阶函数", "order_index": 4, "keywords": ["函数作为参数", "返回函数", "柯里化"], "description": "高阶函数模式"}
