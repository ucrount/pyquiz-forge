        {"code": "js-6.2", "title": "ES Module", "order_index": 2, "keywords": ["import", "export", "default", "动态 import"], "description": "ESM 模块化"},
        {"code": "js-6.3", "title": "Node.js 基础", "order_index": 3, "keywords": ["node", "fs", "path", "require", "process"], "description": "Node 标准库入门"},
        {"code": "js-6.4", "title": "npm 与 package.json", "order_index": 4, "keywords": ["npm", "package.json", "scripts", "dependencies"], "description": "包管理与脚本"},
