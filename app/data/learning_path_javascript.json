        {"code": "js-1.2", "title": "变量与作用域", "order_index": 2, "keywords": ["var", "let", "const", "块级作用域", "暂时性死区"], "description": "let / const 与 var 的差异"},
        {"code": "js-1.3", "title": "数据类型", "order_index": 3, "keywords": ["string", "number", "boolean", "null", "undefined", "object", "symbol", "bigint"], "description": "原始类型与引用类型"},
        {"code": "js-1.4", "title": "运算符与类型转换", "order_index": 4, "keywords": ["==", "===", "+", "Number()", "隐式转换"], "description": "强制/隐式类型转换陷阱"},
        {"code": "js-1.5", "title": "模板字符串与解构", "order_index": 5, "keywords": ["``", "${}", "解构赋值", "rest"], "description": "ES6 字符串与解构语法"}
      ]
    },
    {
