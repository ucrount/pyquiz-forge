        {"code": "js-5.2", "title": "Promise", "order_index": 2, "keywords": ["Promise", "then", "catch", "Promise.all"], "description": "Promise 链式调用"},
        {"code": "js-5.3", "title": "async / await", "order_index": 3, "keywords": ["async", "await", "try/catch"], "description": "同步风格的异步语法"},
        {"code": "js-5.4", "title": "事件循环", "order_index": 4, "keywords": ["event loop", "microtask", "macrotask"], "description": "事件循环与任务队列"}
